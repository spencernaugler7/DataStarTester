<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DataStarTester</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="module" src="~/js/data-star.min.js"></script>
</head>
<body>
    <div class="navbar shadow-sm">
        <div class="flex-1">
            <a class="btn btn-ghost text-xl text-white" asp-area="" asp-controller="Home" asp-action="Index">DataStarTester</a>
        </div>
        <ul class="menu menu-horizontal px-1">
            <li>
                <a class="text-white" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/home.svg" height="25" width="25" />
                    Home
                </a>
            </li>
            <li>
                <a class="text-white" asp-area="" asp-controller="Home" asp-action="Todos">
                    <img src="~/images/info.svg" height="25" width="25" />
                    Todos
                </a>                
            </li>
            <li>
                <a class="text-white" asp-area="" asp-controller="Home" asp-action="Sample">
                    <img src="~/images/info.svg" height="25" width="25" />
                    Sample
                </a>
            </li>
            <li>
                <a class="text-white" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </li>
        </ul>
    </div>
    <div>
        <main role="main" class="p-30">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div>
            &copy; 2026 - DataStarTester - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
