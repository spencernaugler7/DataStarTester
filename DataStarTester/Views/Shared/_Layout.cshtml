<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DataStarTester</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <div class="navbar bg-base-100 shadow-sm">
        <div class="flex-1">
            <a class="btn btn-ghost text-xl" asp-area="" asp-controller="Home" asp-action="Index">DataStarTester</a>
        </div>
        <ul class="menu menu-horizontal px-1">
            <li class="nav-item">
                <a class="text-black-900" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li class="nav-item">
                <a class="text-black-900" asp-area="" asp-controller="Home" asp-action="Sample">Sample</a>
            </li>
            <li class="nav-item">
                <a class="text-black-900" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </li>
        </ul>
    </div>
    <div class="container">
        <main role="main" class="p-30">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - DataStarTester - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="module" src="~/js/data-star.min.js"></script>
    <script src="https://unpkg.com/@@tailwindcss/browser@4"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
