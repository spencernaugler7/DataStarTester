@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="text-9xl">Welcome</h1>
    <p class="text-2xl">Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<!-- shows all signals propigated in the page -->
<pre data-json-signals></pre>

<br />
<br />

<!-- test form controls -->
<main class="card" id="main" data-signals="{'formInput':'', 'output':'Type in input to get output' }">
    <h1 class="text-2xl">Form Test</h1>
    <button class="btn btn-primary" data-on:click="@@get('/displayDate')">Display Date</button>
    <div id="target"></div>
    <br/>
    <input class="input input-primary" type="text" placeholder="input:" data-bind:form-input data-on:keyup="@@post('/changeOutput')"/><br/>
    <span data-text="$output"></span>
    <br/>
    <button data-on:click="@@post('/resetInput')">Revert signals</button>
</main>