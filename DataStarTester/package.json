{
  "name": "datastartester",
  "type": "module",
  "private": true,
  "dependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "daisyui": "^5.5.19",
    "tailwindcss": "^4.2.2"
  },
  "scripts": {
    "css:build": "bun x @tailwindcss/cli -i ./wwwroot/css/site.css -o ./wwwroot/css/output.css --minify",
    "css:watch": "bun x @tailwindcss/cli -i ./wwwroot/css/site.css -o ./wwwroot/css/output.css --minify --watch"
  }
}
